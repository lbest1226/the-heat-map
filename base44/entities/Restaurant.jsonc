{
  "name": "Restaurant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "neighborhood": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "signature_dish": {
      "type": "string"
    },
    "heat_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "heat_label": {
      "type": "string"
    },
    "overall_flavor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "smoke_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "scoville_range": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "spice_profile": {
      "type": "string"
    },
    "bread_pickle_ratio": {
      "type": "string"
    },
    "wait_time": {
      "type": "string"
    },
    "established": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "rank": {
      "type": "integer"
    }
  },
  "required": [
    "name",
    "heat_level"
  ]
}